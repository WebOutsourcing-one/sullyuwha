# Caddy — TLS 종단과 리버스 프록시.
#
# 인증서는 Let's Encrypt에서 자동 발급·갱신된다. 따로 할 일이 없다.
# 조건: DNS A 레코드가 이 인스턴스를 가리키고, 80/443이 열려 있어야 한다.
{$DOMAIN} {
	encode zstd gzip

	reverse_proxy app:5001 {
		# 앱이 요청의 원래 스킴을 알아야 한다.
		# 이 헤더가 없으면 Auth.js가 http로 보고 세션 쿠키 이름을 잘못 잡아
		# 로그인 후 관리자 페이지에서 무한히 로그인 화면으로 튕긴다.
		# (src/proxy.ts의 usesSecureCookies 주석 참고)
		header_up X-Forwarded-Proto {scheme}
	}

	# 이미지·정적 자원은 오래 캐시해도 안전하다(경로에 해시가 붙는다).
	@static path /_next/static/* /favicon.ico
	header @static Cache-Control "public, max-age=31536000, immutable"
}
