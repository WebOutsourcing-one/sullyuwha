# ─────────────────────────────────────────────────────────────
# Production 템플릿 — AWS Lightsail + S3
#
# ⚠️ 이 파일은 git에 추적되는 **템플릿**이다. 실제 비밀값을 여기에 적지 말 것.
#    실제 값은 서버의 `/opt/sullyuwha/.env.production` 에 넣는다(그 이름은 gitignore 대상).
#    파일 이름을 다르게 둔 이유 — 이름이 같으면 서버 파일을 저장소로 복사해 오는
#    순간 AUTH_SECRET과 DB 비밀번호가 그대로 커밋된다.
#    설정 절차는 docs/deploy.md 참고.
#
# ⚠️ 값은 반드시 "비워둔다". `<IAM-access-key>` 같은 플레이스홀더를 넣으면
#    비어있지 않은 문자열이라 코드의 "설정됨" 검사를 통과해버린다.
#    (예: AUTH_SECRET에 고정 문자열이 들어가면 그 값을 아는 누구나
#     admin 역할의 JWT를 위조할 수 있다)
#
# 서버에서 DATA_SOURCE=database 로 설정한다.
# ─────────────────────────────────────────────────────────────

# 비밀값 — 런타임 주입 전용, 여기서는 항상 비워둔다.
DATABASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# 인증 — 자세한 형식은 .env.example 참고.
# AUTH_SECRET 생성:         openssl rand -base64 32
# AUTH_ADMIN_PASSWORD 형식: scrypt:<salt-hex>:<hash-hex> (평문 금지, `$` 사용 금지)
AUTH_SECRET=
# 자체 호스팅 배포 URL (Host 헤더 위조 방지). 예: https://sullyuwha.com
AUTH_URL=
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# 비밀이 아닌 값 — 커밋해도 무방하다.
S3_REGION=ap-northeast-2
S3_BUCKET=

# 버킷을 다른 프로젝트와 공유할 때, 이 프로젝트가 쓸 루트 경로.
# 업로드·삭제·목록이 전부 이 아래에서만 일어난다. 단독 버킷이면 비워둔다.
S3_KEY_PREFIX=

# ⚠️ 아래 두 값은 **끝이 S3_KEY_PREFIX 와 같아야** 한다.
#    읽기 URL은 `{베이스}/{키}.{확장자}` 로 조립되므로, 베이스에 접두사가 빠지면
#    업로드는 멀쩡히 되는데 화면에는 안 나온다 — 가장 찾기 번거로운 형태로 깨진다.
#    예) S3_KEY_PREFIX=sullyuwha
#        S3_PUBLIC_URL=https://<버킷>.s3.<리전>.amazonaws.com/sullyuwha
#    (CDN·커스텀 도메인을 쓰면 origin path로 접두사를 흡수하므로 URL엔 안 보일 수 있다)
S3_PUBLIC_URL=

# ⚠️ 이 값은 **런타임이 아니라 빌드 타임**에 번들로 굳는다.
#    여기 적어도 빌드에는 반영되지 않는다 — 실제로 빌드가 읽는 곳은
#    GitHub → Settings → Secrets and variables → Actions → **Variables** 다.
#    두 곳을 같은 값으로 맞춰 두고, 바꿀 때는 반드시 재배포한다.
NEXT_PUBLIC_ASSET_BASE_URL=
