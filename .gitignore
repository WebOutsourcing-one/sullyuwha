# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# tooling state (oh-my-claudecode / claude)
/.omc/
/.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값이 담긴 파일은 절대 커밋하지 않는다.
# 아래 두 파일은 "값이 비어있는 템플릿"이므로 예외로 추적한다.
# 서버의 실제 .env.production 과 이름이 겹치지 않도록 템플릿은 .example 로 둔다 —
# 이름이 같으면 서버 파일을 저장소로 복사해 오는 순간 비밀값이 그대로 커밋된다.
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI 도구가 내려받는 스킬 캐시 — 세 디렉터리에 같은 내용이 복제된다.
# 저장소가 아니라 각자 로컬에서 관리한다.
.agents/
.claude/
.windsurf/
skills-lock.json
