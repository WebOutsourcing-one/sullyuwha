generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HeroContent {
  id                String  @id @default("default")
  eyebrow           String
  slogan            String
  subcopy           String
  primaryCtaLabel   String  @map("primary_cta_label")
  primaryCtaHref    String  @map("primary_cta_href")
  secondaryCtaLabel String  @map("secondary_cta_label")
  secondaryCtaHref  String  @map("secondary_cta_href")
  imageAssetKey     String  @map("image_asset_key")
  imageAlt          String  @map("image_alt")
  imageAspectRatio  Float?  @map("image_aspect_ratio")
  imageExt          String? @map("image_ext")

  @@map("hero_content")
}

model BrandStory {
  id                 String  @id @default("default")
  eyebrow            String
  title              String
  paragraphs         Json
  nameMeaningReading String  @map("name_meaning_reading")
  nameMeaningMeaning String  @map("name_meaning_meaning")
  imageAssetKey      String  @map("image_asset_key")
  imageAlt           String  @map("image_alt")
  imageAspectRatio   Float?  @map("image_aspect_ratio")
  imageExt           String? @map("image_ext")

  @@map("brand_story")
}

model SilkFeature {
  id               String  @id @default(uuid())
  label            String
  title            String
  description      String
  imageAssetKey    String? @map("image_asset_key")
  imageAlt         String? @map("image_alt")
  imageAspectRatio Float?  @map("image_aspect_ratio")
  imageExt         String? @map("image_ext")
  sortOrder        Int     @default(0) @map("sort_order")

  @@map("silk_feature")
}

model Category {
  id               String  @id @default(uuid())
  labelEn          String  @map("label_en")
  title            String
  imageAssetKey    String  @map("image_asset_key")
  imageAlt         String  @map("image_alt")
  imageAspectRatio Float?  @map("image_aspect_ratio")
  imageExt         String? @map("image_ext")
  href             String
  sortOrder        Int     @default(0) @map("sort_order")

  @@map("category")
}

model BespokeContent {
  id               String  @id @default("default")
  eyebrow          String
  title            String
  paragraphs       Json
  ctaLabel         String  @map("cta_label")
  ctaHref          String  @map("cta_href")
  imageAssetKey    String  @map("image_asset_key")
  imageAlt         String  @map("image_alt")
  imageAspectRatio Float?  @map("image_aspect_ratio")
  imageExt         String? @map("image_ext")

  @@map("bespoke_content")
}

model ProcessStep {
  id        String @id @default(uuid())
  stepId    String @map("step_id")
  icon      String
  title     String
  sortOrder Int    @default(0) @map("sort_order")

  @@map("process_step")
}

model Product {
  id               String         @id
  name             String
  category         String
  material         String
  description      String
  /// 판매가(원). KRW는 보조단위가 없어 정수 원 단위로 저장한다.
  /// 0은 "가격 미정" — 결제 버튼 대신 문의 CTA가 노출된다.
  price            Int            @default(0)
  imageAssetKey    String         @map("image_asset_key")
  imageAlt         String         @map("image_alt")
  imageAspectRatio Float?         @map("image_aspect_ratio")
  imageExt         String?        @map("image_ext")
  /// 목록(메인·컬렉션 카드·주문 요약)용 썸네일. 상세의 대표 컷과 별도로 받는다.
  /// 비어 있으면 화면에서 대표 컷으로 대체된다.
  thumbnailAssetKey String?       @map("thumbnail_asset_key")
  thumbnailAlt      String?       @map("thumbnail_alt")
  thumbnailExt      String?       @map("thumbnail_ext")
  tags             Json
  story            String?
  specs            Json?
  care             Json?
  /// 상세 페이지 에디토리얼 콘텐츠(ProductDetailContent).
  /// 부제·도입부·상징 해설·디테일 블록·모델 컷·유의사항을 한 덩어리로 담는다.
  /// 블록마다 이미지가 딸려 있고 개수가 가변이라 정규화 대신 JSON으로 둔다.
  detail           Json?
  images           ProductImage[]
  orders           Order[]
  sortOrder        Int            @default(0) @map("sort_order")

  @@map("product")
}

model ProductImage {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  assetKey    String  @map("asset_key")
  alt         String
  aspectRatio Float?  @map("aspect_ratio")
  ext         String?
  sortOrder   Int     @default(0) @map("sort_order")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_image")
}

model GalleryItem {
  id          String  @id @default(uuid())
  assetKey    String  @map("asset_key")
  alt         String
  aspectRatio Float?  @map("aspect_ratio")
  ext         String?
  caption     String
  span        String
  sortOrder   Int     @default(0) @map("sort_order")

  @@map("gallery_item")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  orders        Order[]

  @@map("users")
}

/// OAuth 토큰 필드는 반드시 스네이크케이스 **Prisma 필드명**이어야 한다.
/// @auth/prisma-adapter는 공급자의 토큰 응답을 그대로 `linkAccount()`에 넘기므로
/// (`refresh_token`, `expires_at` …) 필드명이 camelCase면 Unknown argument로 실패한다.
/// `@map`으로 컬럼명은 그대로 유지되므로 기존 데이터·컬럼은 영향받지 않는다.
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// 즉시구매 단건 주문 + 토스페이먼츠 결제 1건.
///
/// 결제를 별도 모델로 분리하지 않는 이유 — 이 흐름은 주문당 결제가 정확히 하나다.
/// 부분취소·재결제가 생기면 그때 Payment로 떼어내는 편이 낫다.
///
/// 상품 정보를 FK뿐 아니라 스냅샷(productName·unitPrice)으로도 들고 있는 이유 —
/// 나중에 상품명이나 가격이 바뀌어도 과거 주문 내역은 결제 당시의 값을 보여야 한다.
model Order {
  id          String @id @default(uuid())
  /// 토스에 넘기는 주문번호(= Toss orderId). 6~64자 영숫자·하이픈·언더스코어.
  orderNumber String @unique @map("order_number")
  /// PENDING · PAID · WAITING_FOR_DEPOSIT · FAILED · CANCELED
  status      String @default("PENDING")

  /// 결제 금액(원). **서버가 상품 가격에서 계산한 값**이며 클라이언트 입력을 신뢰하지 않는다.
  /// 승인 직전 토스가 돌려준 금액과 이 값을 대조한다.
  amount   Int
  currency String @default("KRW")

  /// 주문 시점 스냅샷
  productId   String? @map("product_id")
  productName String  @map("product_name")
  unitPrice   Int     @map("unit_price")
  quantity    Int     @default(1)
  orderName   String  @map("order_name")

  /// 주문자
  customerName  String  @map("customer_name")
  customerPhone String  @map("customer_phone")
  customerEmail String? @map("customer_email")

  /// 배송지
  shippingPostcode String? @map("shipping_postcode")
  shippingAddress  String  @map("shipping_address")
  shippingDetail   String? @map("shipping_detail")
  shippingMemo     String? @map("shipping_memo")

  /// 토스 결제 결과
  paymentKey   String?   @unique @map("payment_key")
  method       String?
  approvedAt   DateTime? @map("approved_at")
  receiptUrl   String?   @map("receipt_url")
  failCode     String?   @map("fail_code")
  failMessage  String?   @map("fail_message")
  canceledAt   DateTime? @map("canceled_at")
  cancelReason String?   @map("cancel_reason")

  /// 비회원 주문이면 null. 로그인 상태로 주문하면 계정에 연결된다.
  userId String? @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("order")
}

model ContactInfo {
  id               String  @id @default("default")
  showroomName     String  @map("showroom_name")
  address          String
  phone            String
  email            String
  hours            Json
  note             String
  socials          Json
  imageAssetKey    String? @map("image_asset_key")
  imageAlt         String? @map("image_alt")
  imageAspectRatio Float?  @map("image_aspect_ratio")
  imageExt         String? @map("image_ext")

  @@map("contact_info")
}
