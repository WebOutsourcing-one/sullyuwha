# ─────────────────────────────────────────────────────────────
# Cloudflare R2 — 공개 버킷 + 커스텀 도메인
# ─────────────────────────────────────────────────────────────
# 이미지/에셋을 서빙할 R2 공개 URL의 베이스. 끝 슬래시 없이 입력.
#   - 커스텀 도메인:  https://assets.sullyuwha.com
#   - r2.dev 기본:    https://pub-xxxxxxxx.r2.dev
#
# 비워두면 로컬 개발 시 한지 그라디언트 플레이스홀더로 대체 렌더링된다.
NEXT_PUBLIC_ASSET_BASE_URL=

# ─────────────────────────────────────────────────────────────
# 서버 전용 — NEXT_PUBLIC_ 접두사 금지 (붙이면 클라이언트 번들에 실린다)
#
# ⚠️ 값은 반드시 비워둔다. 여기에 그럴듯한 플레이스홀더를 적으면
#    이 파일을 복사한 환경에서 "설정됨"으로 통과해버린다.
#    특히 AUTH_SECRET에 고정 문자열이 들어가면 그 값을 아는 누구나
#    admin 역할의 JWT를 위조할 수 있다.
# ─────────────────────────────────────────────────────────────

# NextAuth 서명 키. 생성: openssl rand -base64 32
AUTH_SECRET=

# 배포 URL. 자체 호스팅에서는 이 값을 명시해야 콜백 URL이
# 요청의 Host 헤더에서 유도되지 않는다(Host 헤더 위조 방지).
# 예: https://sullyuwha.com
AUTH_URL=

# 소셜 로그인 (선택)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=

# ─────────────────────────────────────────────────────────────
# 관리자 계정
#
# 이 두 값으로 /sull-admin/login 에 로그인한다.
# 계정이 DB에 없으면 첫 로그인 시도 때 자동으로 만들어진다.
# ─────────────────────────────────────────────────────────────
AUTH_ADMIN_EMAIL=

# 관리자 비밀번호. **평문을 그대로 넣으면 된다** — 앱이 scrypt로 해싱해서
# DB(users.password_hash)에 저장한다. env에는 해싱된 값이 되돌아오지 않는다.
#
#   AUTH_ADMIN_PASSWORD=myAdminPassword
#
# 동작:
#   - 계정이 없으면 이 비밀번호로 관리자 계정을 생성한다.
#   - 계정이 있는데 이 값이 저장된 것과 다르면 저장된 해시를 이 값으로 갱신한다.
#     (비밀번호 변경 = env 수정 후 재시작)
#   - 이 값을 **비워 두면 DB에 저장된 해시로 검증한다.** 즉 최초 1회 로그인 뒤에는
#     env에서 평문을 지워도 로그인이 유지된다. 운영에서는 지워 두는 편이 안전하다.
#
# 평문을 env에 남기고 싶지 않다면 미리 해싱한 값을 넣어도 된다:
#   node -e "const c=require('crypto'),s=c.randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" 'YOUR_PASSWORD'
#   ※ 구분자가 `:` 인 이유: env 값 안의 `$`는 dotenv-expand가 변수 참조로 보고
#      빈 문자열로 치환해버려서 해시가 조용히 잘린다.
# `scrypt:` 로 시작하는데 형식이 어긋나면 로그인은 거부된다(fail-closed).
AUTH_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────
# 토스페이먼츠
#
# 개발자센터(https://developers.tosspayments.com) → 내 개발정보에서 발급한다.
# 테스트 키는 `test_`, 라이브 키는 `live_` 로 시작한다.
#
# 결제 흐름을 타려면 DATA_SOURCE=database 로 실제 DB를 써야 한다.
# 정적 데이터는 판매가가 0("가격 미정")이라 결제 버튼이 나가지 않는다.
# ─────────────────────────────────────────────────────────────

# 클라이언트 키 — 브라우저에 노출되는 것이 정상이다(결제위젯이 사용).
# 이 키만으로는 승인이 되지 않는다. 실제 승인은 아래 시크릿 키가 한다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 시크릿 키 — ⚠️ 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 이 값이 유출되면 임의 금액의 승인·환불이 가능하다.
# 비어 있으면 결제 승인은 실패한다(성공으로 폴백하지 않는다).
TOSS_SECRET_KEY=

# 가상계좌 입금 확인을 받으려면 개발자센터 → 웹훅에
# `PAYMENT_STATUS_CHANGED` 이벤트를 아래 경로로 등록한다.
#   https://<도메인>/api/payments/webhook
# 등록하지 않으면 가상계좌 주문이 '입금 대기'에서 넘어가지 않는다.
